{
  "name": "dsh-plugin-doctor",
  "version": "0.0.1",
  "description": "Static health checks for DeepSeek Harness plugins: can it install, what can it touch, will it conflict.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "dsh-plugin-doctor": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "lint",
    "audit",
    "cordis"
  ],
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
